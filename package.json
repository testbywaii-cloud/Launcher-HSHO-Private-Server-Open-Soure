{
  "name": "hsho-private-launcher",
  "version": "1.0.5",
  "description": "LYWP Private Launcher",
  "author": "ํYOUR_NAME_OR_TEXT",
  "main": "main.js",
  "type": "commonjs",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "YOUR_LINK_GITHUB"
  },
  "scripts": {
    "start": "electron .",
    "dev": "nodemon server.js",
    "build": "electron-builder --win",
    "publish": "electron-builder --win --publish always"
  },
  "_moduleAliases": {
    "@src": "src",
    "@config": "src/config",
    "@routes": "src/routes",
    "@controllers": "src/controllers",
    "@services": "src/services",
    "@models": "src/models",
    "@utils": "src/utils",
    "@middleware": "src/middleware",
    "@data": "data"
  },
  "build": {
    "appId": "com.hsho.launcher",
    "productName": "LYWP Launcher",
    "publish": [
      {
        "provider": "github",
        "owner": "YOUR_NAME_IN_GITHUB",
        "repo": "Update"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!certs/*",
      "!dist/*",
      "!mods/*"
    ],
    "extraResources": [
      "certs/**/*",
      ".env"
    ],
    "asar": true,
    "asarUnpack": [
      "server.js",
      "config/**/*",
      "routes/**/*",
      "src/**/*",
      "data/**/*",
      "node_modules/module-alias/**/*",
      "node_modules/dotenv/**/*",
      "node_modules/discord-rpc/**/*"
    ],
    "win": {
      "icon": "icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "unicode": true,
      "differentialPackage": false
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "discord-rpc": "^4.0.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "extract-zip": "^2.0.1",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.3.4",
    "mongoose": "^9.9.2",
    "node-forge": "^1.3.1",
    "sudo-prompt": "^9.2.1",
    "systeminformation": "^5.33.5",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "electron": "31.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.2",
    "nodemon": "^3.0.0",
    "prettier": "^3.7.4"
  }
}
